# ------------------------------------------------------------
# TiDB / MySQL
# ------------------------------------------------------------
TIDB_HOST=your-tidb-host
TIDB_PORT=4000
TIDB_DATABASE=your_database_name
TIDB_USERNAME=your_username
TIDB_PASSWORD=your_password

# ------------------------------------------------------------
# Firebase Web Config (Phone Auth)
# Firebase console -> Project settings -> Your apps -> Config
# ------------------------------------------------------------
FIREBASE_WEB_API_KEY=your_firebase_api_key
FIREBASE_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-project-id
FIREBASE_WEB_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_WEB_APP_ID=your_app_id

# ------------------------------------------------------------
# OAuth2 Social Login (Google / Naver / Kakao)
# callback: {BASE_URL}/sns/{registrationId}-callback
# ex) https://homepick.onrender.com/sns/google-callback
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# ------------------------------------------------------------
# 카카오맵 (지도 중심 실거래 조회 /map)
# 카카오 디벨로퍼스 > 앱 > 제품 설정 > 카카오맵 > 사용 설정 ON
# KAKAO_JS_KEY: 앱 키 > JavaScript 키 (플랫폼 > Web 에 사이트 도메인 등록)
# KAKAO_REST_API_KEY: 좌표 변환(ml-pipeline/05_geocode.py), 비우면 KAKAO_CLIENT_ID 사용
# ------------------------------------------------------------
KAKAO_JS_KEY=your_kakao_javascript_key
KAKAO_REST_API_KEY=

# ------------------------------------------------------------
# AI 추천 데이터 갱신 (GitHub Actions 실행용)
# GitHub > Settings > Developer settings > Fine-grained token
# Repository access: homepick_lo / Permissions: Actions (Read and write)
# ------------------------------------------------------------
GITHUB_ACTIONS_TOKEN=your_github_fine_grained_token
GITHUB_REPO=fsclass-n/homepick_lo

# ------------------------------------------------------------
# ml-pipeline (Python): 국토교통부_아파트 매매 실거래가 자료
# 공공데이터포털 > 마이페이지 > 일반 인증키(Decoding)
# GitHub Actions 에서는 저장소 Secrets 의 DATA_GO_KR_API_KEY 사용
# ------------------------------------------------------------
DATA_GO_KR_API_KEY=your_decoding_service_key
CRAWL_MONTHS=6
